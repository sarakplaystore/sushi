{
  "name": "sushi",
  "version": "1.0.0",
  "private": true,
  "description": "Sushi \u2014 Self-hosted & Vercel-ready Web SSH, SFTP, and RDP Workspace",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "gateway": "NODE_ENV=production GATEWAY_ONLY=true tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:home-screen && npm run test:mobile-home && npm run test:imports && npm run test:os-commands && npm run test:resume && npm run test:cross-device && npm run test:hosts && npm run test:storage-setup && npm run test:sync && npm run test:turso && npm run test:firestore && npm run test:autounlock-stop && npm run test:donate && npm run test:disclaimer && npm run test:installers && npm run test:gateway-deploy && npm run test:gateway-template && npm run test:gateway-guide && npm run test:gateway-token-ui && npm run test:gateway-provision && npm run test:line-editor && npm run test:sftp-elevation && npm run test:sftp-selection && npm run test:rdp && npm run test:shared-ssh && npm run test:retained-pty && tsx tests/e2e-protocols.test.ts",
    "test:rdp": "tsx tests/rdp-live-e2e.test.ts",
    "test:shared-ssh": "tsx tests/shared-ssh.test.ts && tsx tests/vercel-sharing.test.ts && tsx tests/terminal-share-ui.test.tsx",
    "test:retained-pty": "tsx tests/retained-pty-registry.test.ts && tsx tests/retained-pty.test.ts && tsx tests/retained-pty-client.test.tsx",
    "test:autounlock-stop": "tsx tests/vault-autounlock-and-stop-bg.test.ts",
    "test:home-screen": "tsx tests/home-screen.test.ts",
    "test:mobile-home": "tsx tests/mobile-home.test.ts",
    "test:storage-setup": "tsx tests/storage-setup.test.tsx",
    "test:sync": "tsx tests/vault-sync.test.ts",
    "test:turso": "tsx tests/turso-sync.test.ts",
    "test:cross-device": "tsx tests/cross-device-workspace.test.ts",
    "test:imports": "tsx tests/import-clients.test.ts && tsx tests/import-xml.test.ts",
    "test:firestore": "tsx tests/firestore-sync.test.ts",
    "test:os-commands": "tsx tests/os-commands.test.ts",
    "test:resume": "tsx tests/session-resume.test.ts",
    "test:hosts": "tsx tests/unified-hosts.test.ts && tsx tests/all-hosts.test.ts",
    "migrate:firestore": "tsx scripts/migrate-firestore.ts",
    "test:donate": "tsx tests/donate.test.ts",
    "test:disclaimer": "tsx tests/disclaimer.test.ts",
    "test:installers": "tsx tests/installers.test.ts",
    "test:gateway-deploy": "tsx tests/gateway-deploy.test.ts",
    "test:gateway-template": "tsx tests/gateway-template.test.ts",
    "test:gateway-guide": "tsx tests/gateway-guide.test.tsx",
    "test:gateway-token-ui": "tsx tests/gateway-token-ui.test.tsx",
    "test:gateway-provision": "tsx tests/gateway-provision.test.ts && tsx tests/gateway-runtime.test.ts",
    "test:line-editor": "tsx tests/line-editor.test.ts",
    "test:sftp-elevation": "tsx tests/sftp-elevation.test.ts",
    "test:sftp-selection": "tsx tests/sftp-selection.test.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "fflate": "^0.8.3",
    "google-auth-library": "^11.3.3",
    "guacamole-common-js": "^1.5.0",
    "ironrdp-wasm": "^1.3.0",
    "lucide-react": "^1.64.0",
    "next": "^16.4.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "^6.0.0",
    "sql.js": "^1.15.2",
    "ssh2": "^1.17.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.11",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "rimraf": "^6.1.4"
  }
}
