# -----------------------------------------------------------------------------
# Sushi — Self-Hosted VPS & Vercel Hybrid Configuration
# -----------------------------------------------------------------------------

# Admin Authentication, Passkeys & Whitelisted Private Keys
# Leave SUSHI_AUTH_USERNAME / SUSHI_AUTH_PASSWORD blank to create one admin
# account interactively. Self-hosted uses DATA_DIR by default; Vercel needs
# Firestore or Redis storage configured below. Or set credentials via environment.
SUSHI_AUTH_USERNAME=
SUSHI_AUTH_PASSWORD=
SUSHI_AUTH_SECRET=
# Optional multi-line OpenSSH authorized_keys (e.g. "ssh-ed25519 AAAAC3... admin")
# allowing whitelisted private-key login to Sushi
SUSHI_AUTHORIZED_KEYS=
# Optional JSON array of WebAuthn Passkeys (shared storage also persists passkeys)
SUSHI_PASSKEYS_JSON=

# Bind host & port when running self-hosted Node/WebSocket server (`npm start`)
HOST=0.0.0.0
PORT=3000

# Apache Guacamole daemon endpoint for live HTML5 RDP desktop streaming
# Automatically set to `guacd:4822` inside docker-compose.yml
GUACD_HOST=127.0.0.1
GUACD_PORT=4822

# Optional shared secret token required by API & WebSocket endpoints
# Required when a Vercel-hosted Sushi uses this server as its VPS Gateway:
# enter the same value in Sushi -> Gateway settings (generate: openssl rand -hex 24)
SUSHI_GATEWAY_TOKEN=

# Optional default VPS Gateway URL baked into Vercel client builds
# e.g. https://sushi-gw.yourdomain.com
NEXT_PUBLIC_GATEWAY_URL=

# Allowed CORS origin when pairing a VPS Gateway with a Vercel frontend
ALLOWED_ORIGIN=*

# Persist encrypted vault ciphertext (true/false). Self-hosted defaults to disk;
# Vercel requires persistent Firestore or Redis storage for account + vault sync.
SUSHI_SERVER_VAULT=true
DATA_DIR=./data

# Select auto (the default), disk, redis, or firestore. Auto retains the old
# behavior: Redis if configured, otherwise disk on a VPS or none on Vercel.
# Selecting another backend does NOT move existing account/vault data.
SUSHI_STORAGE_BACKEND=

# Optional Google Cloud Firestore live sync (server-side only). Create a Native
# mode database and give the service account Cloud Datastore User permission.
# Explicitly set SUSHI_STORAGE_BACKEND=firestore; use the same project, database
# and SUSHI_STORAGE_PREFIX on all instances sharing one account.
SUSHI_FIRESTORE_PROJECT_ID=
SUSHI_FIRESTORE_DATABASE_ID=
# Paste service-account JSON as one server-side secret, or leave blank to use
# Application Default Credentials. Never prefix credentials with NEXT_PUBLIC_.
SUSHI_FIRESTORE_CREDENTIALS_JSON=
# Optional ADC credential-file path; in Docker the file must exist in the container.
# GOOGLE_APPLICATION_CREDENTIALS=

# Vercel / optional self-hosted shared storage: use a Redis service with an
# Upstash-compatible REST API. Set BOTH values as server-side secrets; never use
# NEXT_PUBLIC_ for the token. Vercel Upstash/KV integrations may instead supply
# UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN, or KV_REST_API_URL +
# KV_REST_API_TOKEN. Choose ONE pair; a partial pair fails closed.
SUSHI_REDIS_REST_URL=
SUSHI_REDIS_REST_TOKEN=
# Optional namespace; use the same value on all instances sharing one account.
# Default: sushi:<Vercel project ID>:<Vercel environment> (or sushi:default:default).
SUSHI_STORAGE_PREFIX=
# Legacy Vercel browser-local setup only; it does NOT enable cross-device sync.
# SUSHI_ALLOW_STATELESS_SETUP=true

# Set to true on public multi-tenant deployments to block RFC1918/loopback targets
# (Cloud metadata IPs such as 169.254.169.254 are always blocked)
BLOCK_PRIVATE_NETWORKS=false

# SSH connection reuse: keeps a command's SSH connection open so the next command
# (and the next keystroke) skips the handshake. `off` = one connection per request.
SUSHI_SSH_POOL=on
SUSHI_SSH_POOL_IDLE_MS=90000
SUSHI_SSH_POOL_MAX=8
SUSHI_SSH_POOL_MAX_AGE_MS=600000
