# -----------------------------------------------------------------------------
# Sushi — Self-Hosted VPS & Vercel Hybrid Configuration
# -----------------------------------------------------------------------------

# Admin Authentication & Passkeys
# On a VPS, leave these blank to create one admin account interactively.
# On Vercel, set SUSHI_AUTH_USERNAME and SUSHI_AUTH_PASSWORD as server-side
# environment variables and redeploy. Use a long, unique password.
# A stable random SUSHI_AUTH_SECRET is strongly recommended (openssl rand -hex 32).
SUSHI_AUTH_USERNAME=
SUSHI_AUTH_PASSWORD=
SUSHI_AUTH_SECRET=
# Optional JSON array of WebAuthn Passkeys (disk also persists passkeys)
SUSHI_PASSKEYS_JSON=

# Bind host & port when running self-hosted Node/WebSocket server (`npm start`)
HOST=0.0.0.0
PORT=3000

# Apache Guacamole daemon endpoint for live HTML5 RDP desktop streaming
# Automatically set to `guacd:4822` inside docker-compose.yml
GUACD_HOST=127.0.0.1
GUACD_PORT=4822

# Optional shared secret token required by API & WebSocket endpoints
# Required when a Vercel-hosted Sushi uses this server as its VPS Gateway:
# enter the same value in Sushi -> Gateway settings (generate: openssl rand -hex 24)
#
# Where this token lives when the gateway runs on a managed host instead of a VPS
# (Sushi's Gateway panel links to the same places next to its token field):
#   Railway  set it as a service variable, sushi-gateway -> Variables
#            https://railway.com/new  ·  https://docs.railway.com/variables
#   Render   render.yaml generates it; read it under sushi-gateway -> Environment
#            https://dashboard.render.com
#            https://render.com/docs/configure-environment-variables
SUSHI_GATEWAY_TOKEN=

# Gateway-only mode: serve /ws/ssh + /ws/rdp and nothing else, for pairing a
# persistent WebSocket PTY gateway with a Vercel-hosted Sushi UI. Every other
# /api/* route then 404s on purpose so the frontend keeps using its own serverless
# endpoints. `npm run gateway` sets this; Dockerfile.gateway bakes it in, and
# render.yaml / .railway/railway.ts set it on Render and Railway.
GATEWAY_ONLY=false

# Optional default VPS Gateway URL baked into Vercel client builds
# e.g. https://sushi-gw.yourdomain.com
NEXT_PUBLIC_GATEWAY_URL=

# Allowed CORS origin when pairing a VPS Gateway with a Vercel frontend
# On Railway / Render set this to the exact Vercel origin, e.g.
# https://your-app.vercel.app (no trailing slash)
ALLOWED_ORIGIN=*

# Persist encrypted vault ciphertext on self-hosted disk (true/false).
# Vercel stores its encrypted vault in the browser only; use portable backups
# to move vaults between devices and keep copies before clearing browser data.
SUSHI_SERVER_VAULT=true
DATA_DIR=./data
# Optional: auto (default) or disk. Disk is not available on Vercel.
SUSHI_STORAGE_BACKEND=

# Set to true on public multi-tenant deployments to block RFC1918/loopback targets
# (Cloud metadata IPs such as 169.254.169.254 are always blocked)
BLOCK_PRIVATE_NETWORKS=false

# SSH connection reuse: keeps a command's SSH connection open so the next command
# (and the next keystroke) skips the handshake. `off` = one connection per request.
SUSHI_SSH_POOL=on
SUSHI_SSH_POOL_IDLE_MS=90000
SUSHI_SSH_POOL_MAX=8
SUSHI_SSH_POOL_MAX_AGE_MS=600000

# Team sharing (Share in the terminal header): how many shells may be shared at
# once, how long a shared shell with nobody attached is kept alive, and how much
# scrollback is replayed to someone who joins late. Sharing needs a persistent
# process (VPS / Docker / gateway) - it is unavailable on Vercel serverless.
SUSHI_SHARE_MAX_SESSIONS=50
SUSHI_SHARE_IDLE_TTL_MS=43200000
SUSHI_SHARE_SCROLLBACK_BYTES=262144
