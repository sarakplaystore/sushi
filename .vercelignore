# CLI deployments must not upload local credentials, vaults, or build artifacts.
# The .env import helper uses a Git-based deployment, but this also protects
# ordinary (non-prebuilt) local CLI deployments.
.env*
.vercel
.git
node_modules
.next
out
build
dist
.pnp
.pnp.*
data/*.json
data/*.enc*
data/*.lock
data/*.tmp
.sushi
*.pem
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
