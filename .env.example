# -----------------------------------------------------------------------------
# Sushi — Self-Hosted VPS & Vercel Hybrid Configuration
# -----------------------------------------------------------------------------

# Admin Username & Password Protection
# On a VPS, leave blank to configure interactively via the First-Run Setup screen
# (saved as scrypt hash in DATA_DIR/auth.json), OR set explicitly below.
# On Vercel (stateless), set SUSHI_AUTH_USERNAME and SUSHI_AUTH_PASSWORD in Project Settings.
SUSHI_AUTH_USERNAME=
SUSHI_AUTH_PASSWORD=
SUSHI_AUTH_SECRET=
# Optional JSON array of WebAuthn Passkeys for cross-device serverless persistence on Vercel
SUSHI_PASSKEYS_JSON=

# Bind host & port when running self-hosted Node/WebSocket server (`npm start`)
HOST=0.0.0.0
PORT=3000

# Apache Guacamole daemon endpoint for live HTML5 RDP desktop streaming
# Automatically set to `guacd:4822` inside docker-compose.yml
GUACD_HOST=127.0.0.1
GUACD_PORT=4822

# Optional shared secret token required by API & WebSocket endpoints
# Recommended when exposing a VPS Gateway to a Vercel-hosted Sushi frontend
SUSHI_GATEWAY_TOKEN=

# Optional default VPS Gateway URL baked into Vercel client builds
# e.g. https://sushi-gw.yourdomain.com
NEXT_PUBLIC_GATEWAY_URL=

# Allowed CORS origin when pairing a VPS Gateway with a Vercel frontend
ALLOWED_ORIGIN=*

# Persist AES-256-GCM encrypted vault ciphertext on VPS disk (true/false)
SUSHI_SERVER_VAULT=true
DATA_DIR=./data

# Set to true on public multi-tenant deployments to block RFC1918/loopback targets
# (Cloud metadata IPs such as 169.254.169.254 are always blocked)
BLOCK_PRIVATE_NETWORKS=false
